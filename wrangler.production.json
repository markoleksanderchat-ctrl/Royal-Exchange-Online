{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "royal-exchange-online",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "royal-exchange-history",
      "database_id": "c5622c1b-f10f-48ef-9288-2c4f1e0a71bf",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
